	(text "LM5164-Q1 COT buck: VIN_PROT (7.5-58V) -> V6P0 (6.0V, 1A)"
		(exclude_from_sim yes)
		(at 17 23.5 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left)
		)
		(uuid "8c9bb1e1-818b-4eb6-83a9-427151809ced")
	)
	(text "Buck design (TI LM5164-Q1 SNVSB51C):\n  VOUT=6.0V chosen so TCAN4550 VSUP (5.5-30V rec., abs 42V) stays in range and TCAN LDO dissipation is low (VSUP-5V=1V).\n  fsw ~300kHz (RON 49.9k), L=47uH -> dIL ~ 0.3A pk-pk @24V; ILIM 1.5A typ.  Type-3 ripple injection RA/CA/CB.\n  UVLO 7.5V/7.0V: below this the buck stops; system continues from backup battery (see sheet 3).\n  EMC/EMI: 300kHz harmonics fall in AM band -> CISPR25 conducted-emission test and input filter tuning are TO BE VALIDATED."
		(exclude_from_sim yes)
		(at 20 210 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a924f34a-d489-4b5b-8662-5649d01ed514")
	)
