	(text "B. Ideal-diode reverse-battery protection (LM74700-Q1 + BUK7Y41-80E)"
		(exclude_from_sim yes)
		(at 17 158.5 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left)
		)
		(uuid "0a85d0ae-376b-4ac6-8e50-b3892859e0d3")
	)
	(text "Design intent (source: LM74700-Q1 SNOSD17G, SMDJ36CA datasheet):\n- Reverse battery to -36V: bidirectional TVS (VRWM 36V) does not conduct; LM74700 keeps FET off, body diode blocks.\n- Load dump: TVS clamps VIN_FUSED to <= 58.1V (Vc max) - inside LM74700 ANODE 60V recommended window; FET is 80V.\n- Fuse F1 protects harness/board against TVS failed-short and FET/buck faults.  J1-3 IGN is fed to TCAN4550 WAKE via R-C network (CAN sheet)."
		(exclude_from_sim yes)
		(at 20 28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "432ce2f0-e296-4daf-869b-289fd277b8a1")
	)
